<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>SCADA_ERMIS_II</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ErmisFileRecorder.vb.vb" />
    <Compile Include="MissionControlProtocol.vb" />
    <Compile Include="MissionControlClient.vb" />
    <Compile Include="LiveSpectrogramControl.vb" />
    <Compile Include="ErmisMonitorForm.vb" />
    <Compile Include="ErmisMonitorForm.Designer.vb">
      <DependentUpon>ErmisMonitorForm.vb</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Include="RobustModbusRtuMaster.vb" />
    <Compile Include="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Include="My Project\ApplicationEvents.vb" />
    <Compile Include="TelemetryModels.vb" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ErmisSensorStatusTool\ErmisSensorStatusTool.csproj" />
  </ItemGroup>

</Project>
